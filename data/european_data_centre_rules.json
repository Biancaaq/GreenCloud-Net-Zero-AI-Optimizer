{
  "metadata": {
    "project": "Sustainable Data Centre Placement and Retrofit - Europe",
    "version": "1.2",
    "principle": "Do not optimize for company profit. Optimize for minimum ecological damage, grid safety, water safety and regulatory compliance.",
    "last_updated": "2026-05-09",
    "data_quality_note": "Only confirmed rules/restrictions are encoded as hard constraints. Unknown local rules are marked as research_required. Some environmental flags are modelling checks, not legal restrictions."
  },
  "eu_rules": {
    "scope": "EU",
    "data_centre_reporting": {
      "legal_basis": [
        "Energy Efficiency Directive EU/2023/1791",
        "Commission Delegated Regulation EU/2024/1364"
      ],
      "applies_to": "data centres with installed IT power demand of at least 500 kW",
      "required_kpis": [
        "PUE",
        "WUE",
        "ERF",
        "REF"
      ],
      "required_reported_data": [
        "energy_consumption",
        "water_footprint",
        "renewable_energy_use"
      ],
      "rule_type": "mandatory_reporting",
      "use_in_code": [
        "existing_data_centre_assessment",
        "new_data_centre_compliance_check"
      ],
      "source_urls": [
        "https://energy.ec.europa.eu/topics/energy-efficiency/energy-efficiency-targets-directive-and-rules/energy-efficiency-directive/energy-performance-data-centres_en",
        "https://eur-lex.europa.eu/eli/reg_del/2024/1364/oj/eng"
      ]
    },
    "best_practice_framework": {
      "name": "EU Code of Conduct for Data Centre Energy Efficiency - Best Practices 2024",
      "rule_type": "best_practice_guidance",
      "retrofit_relevance": [
        "cooling_optimization",
        "airflow_management",
        "IT_equipment_utilization",
        "power_distribution_efficiency",
        "energy_monitoring"
      ],
      "source_urls": [
        "https://e3p.jrc.ec.europa.eu/publications/2024-best-practice-guidelines-eu-code-conduct-data-centre-energy-efficiency",
        "https://e3p.jrc.ec.europa.eu/sites/default/files/2024-04/JRC136986_2024_best_practice_guidelines.pdf"
      ]
    }
  },
  "countries": {
    "Ireland": {
      "eu_member": true,
      "risk_level": "high",
      "new_data_centres": {
        "grid_connection_policy_specific_to_data_centres": true,
        "applies_to": "new data centre connection applications under the CRU Large Energy Users Connection Policy after 12 December 2025",
        "requires_new_renewable_generation": true,
        "requires_dispatchable_generation": true,
        "constrained_region_check_required": true,
        "recommendation": "Do not recommend new data centres unless renewable generation, dispatchable capacity and grid constraints are addressed."
      },
      "existing_data_centres": {
        "retrofit_priorities": [
          "reduce_grid_pressure",
          "increase_renewable_supply",
          "improve_energy_monitoring",
          "reduce_peak_demand"
        ]
      },
      "source_urls": [
        "https://www.cru.ie/about-us/news/the-cru-publishes-its-decision-on-new-electricity-connection-policy-for-data-centres/",
